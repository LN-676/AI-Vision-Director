AIVD_POSTGRES_PASSWORD=replace-with-a-local-development-secret
AIVD_FIREBASE_PROJECT_ID=your-firebase-project-id
AIVD_CORS_ALLOW_ORIGINS=https://console.example.com
AIVD_DATABASE_URL_SECRET_FILE=./secrets/database_url.txt
