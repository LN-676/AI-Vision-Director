AIVD_RATE_LIMIT_REQUESTS=30
AIVD_RATE_LIMIT_WINDOW_SECONDS=60
AIVD_FORWARDED_ALLOW_IPS=127.0.0.1
AIVD_STATELESS_MODE=false
