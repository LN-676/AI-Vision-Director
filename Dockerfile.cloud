FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app
COPY requirements-cloud.txt .
RUN pip install --no-cache-dir -r requirements-cloud.txt

COPY alembic.ini .
COPY migrations migrations
COPY src src
COPY tests tests

EXPOSE 8080
CMD ["python", "-m", "autocamtracker.api.public_main"]
